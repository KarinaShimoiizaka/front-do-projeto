# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# EMPREST.AI — frontend (Next.js)
#
# Dois alvos:
#   --target dev     desenvolvimento, com hot reload (é o que o compose usa)
#   --target runner  produção, imagem enxuta a partir do output standalone
# ---------------------------------------------------------------------------

FROM node:22-alpine AS base
WORKDIR /app
# O Next roda melhor com libc6-compat no Alpine.
RUN apk add --no-cache libc6-compat


# --- dependências ----------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci


# --- desenvolvimento -------------------------------------------------------
FROM base AS dev
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Sem o polling o watcher não enxerga mudanças vindas de bind mount no Windows.
ENV WATCHPACK_POLLING=true
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "dev", "--hostname", "0.0.0.0"]


# --- build de produção -----------------------------------------------------
FROM base AS builder
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN node node_modules/next/dist/bin/next build


# --- produção --------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

# O output standalone já traz só o node_modules que o servidor usa.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
